generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  emailVerified Boolean @default(false)
  settings Json @default("{\"theme\":\"light\",\"snapToGrid\":true,\"autosave\":true}")
  createdAt DateTime @default(now())
  sessions Session[]
  tokens AuthToken[]
  diagrams Diagram[]
  notations Notation[]
  modelSpace ModelSpace?
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}
model AuthToken {
  id String @id
  kind String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, kind])
}
model Notation {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  versions NotationVersion[]
  @@index([ownerId])
}
model NotationVersion {
  id String @id @default(cuid())
  notationId String
  notation Notation @relation(fields: [notationId], references: [id], onDelete: Cascade)
  number Int
  document Json
  createdAt DateTime @default(now())
  diagrams Diagram[]
  bindings DiagramNotation[]
  @@unique([notationId, number])
}
model Diagram {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notationVersionId String?
  notationVersion NotationVersion? @relation(fields: [notationVersionId], references: [id], onDelete: Restrict)
  name String
  modelSpaceId String?
  modelSpace ModelSpace? @relation(fields: [modelSpaceId], references: [id], onDelete: Cascade)
  usages DiagramObjectUsage[]
  relationUsages DiagramRelationUsage[]
  bindings DiagramNotation[]
  revision Int @default(1)
  document Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions DiagramRevision[]
  @@index([ownerId, updatedAt])
}
model DiagramRevision {
  id String @id @default(cuid())
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  number Int
  document Json
  reason String @default("save")
  createdAt DateTime @default(now())
  @@unique([diagramId, number])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model ModelSpace {
  id String @id @default(cuid())
  ownerId String @unique
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String @default("Личная модель")
  revision Int @default(1)
  objects ModelObject[]
  relations ModelRelation[]
  diagrams Diagram[]
}
model ModelObject {
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  copiedFrom Json?
  parentId String?
  name String
  description String @default("")
  attributes Json @default("{}")
  archived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ModelObjectRevision[]
  usages DiagramObjectUsage[]
  @@unique([spaceId, id])
  @@index([spaceId, parentId])
}
model ModelObjectRevision {
  id String @id @default(cuid())
  objectId String
  object ModelObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  number Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([objectId, number])
}
model DiagramObjectUsage {
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  objectId String
  object ModelObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  count Int
  @@id([diagramId, objectId])
  @@index([objectId])
}
model DiagramNotation {
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  bindingId String
  versionId String?
  version NotationVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)
  @@id([diagramId, bindingId])
}

model ModelRelation {
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sourceId String
  targetId String
  parentId String?
  name String
  description String @default("")
  attributes Json @default("{}")
  copiedFrom Json?
  archived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ModelRelationRevision[]
  usages DiagramRelationUsage[]
  @@unique([spaceId, id])
  @@index([spaceId, sourceId])
  @@index([spaceId, targetId])
  @@index([spaceId, parentId])
}
model ModelRelationRevision {
  id String @id @default(cuid())
  relationId String
  relation ModelRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  number Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([relationId, number])
}
model DiagramRelationUsage {
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  relationId String
  relation ModelRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  count Int
  @@id([diagramId, relationId])
  @@index([relationId])
}
