generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  emailVerified Boolean @default(false)
  settings Json @default("{\"theme\":\"light\",\"snapToGrid\":true,\"autosave\":true}")
  createdAt DateTime @default(now())
  sessions Session[]
  tokens AuthToken[]
  diagrams Diagram[]
  notations Notation[]
  modelSpaces ModelSpace[]
  memberships WorkspaceMember[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}
model AuthToken {
  id String @id
  kind String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, kind])
}
model Notation {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  versions NotationVersion[]
  @@index([ownerId])
}
model NotationVersion {
  id String @id @default(cuid())
  notationId String
  notation Notation @relation(fields: [notationId], references: [id], onDelete: Cascade)
  number Int
  document Json
  createdAt DateTime @default(now())
  diagrams Diagram[]
  bindings DiagramNotation[]
  @@unique([notationId, number])
}
model Diagram {
  viewpointId String?
  viewpoint DiagramViewpoint? @relation(fields: [viewpointId], references: [id], onDelete: Restrict)
  outgoingContextLinks DiagramContextLink[] @relation("ContextSource")
  incomingContextLinks DiagramContextLink[] @relation("ContextTarget")
  entityId String? @unique
  entity ModelObject? @relation(fields: [entityId], references: [id], onDelete: NoAction)
  shareToken String? @unique
  shareEnabled Boolean @default(false)
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notationVersionId String?
  notationVersion NotationVersion? @relation(fields: [notationVersionId], references: [id], onDelete: Restrict)
  name String
  modelSpaceId String?
  modelSpace ModelSpace? @relation(fields: [modelSpaceId], references: [id], onDelete: Cascade)
  usages DiagramObjectUsage[]
  relationUsages DiagramRelationUsage[]
  bindings DiagramNotation[]
  revision Int @default(1)
  document Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions DiagramRevision[]
  @@index([ownerId, updatedAt])
  @@index([modelSpaceId, updatedAt])
}
model DiagramRevision {
  id String @id @default(cuid())
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  number Int
  document Json
  reason String @default("save")
  createdAt DateTime @default(now())
  @@unique([diagramId, number])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model ModelSpace {
  members WorkspaceMember[]
  roles WorkspaceRole[]
  locks WorkspaceLock[]
  events WorkspaceEvent[]
  collaborationRevision Int @default(0)
  viewpoints DiagramViewpoint[]
  contextLinks DiagramContextLink[]
  id String @id @default(cuid())
  ownerId String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
  name String @default("Личная модель")
  revision Int @default(1)
  objects ModelObject[]
  relations ModelRelation[]
  diagrams Diagram[]
}
model ModelObject {
  shareToken String? @unique
  shareEnabled Boolean @default(false)
  kind String @default("object")
  diagram Diagram?
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  copiedFrom Json?
  parentId String?
  name String
  description String @default("")
  attributes Json @default("{}")
  archived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ModelObjectRevision[]
  usages DiagramObjectUsage[]
  @@unique([spaceId, id])
  @@index([spaceId, parentId])
}
model ModelObjectRevision {
  id String @id @default(cuid())
  objectId String
  object ModelObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  number Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([objectId, number])
}
model DiagramObjectUsage {
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  objectId String
  object ModelObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  count Int
  @@id([diagramId, objectId])
  @@index([objectId])
}
model DiagramNotation {
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  bindingId String
  versionId String?
  version NotationVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)
  @@id([diagramId, bindingId])
}

model ModelRelation {
  relationType String @default("")
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sourceId String
  targetId String
  parentId String?
  name String
  description String @default("")
  attributes Json @default("{}")
  copiedFrom Json?
  archived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ModelRelationRevision[]
  usages DiagramRelationUsage[]
  contextLink DiagramContextLink?
  @@unique([spaceId, id])
  @@index([spaceId, sourceId])
  @@index([spaceId, targetId])
  @@index([spaceId, parentId])
}
model ModelRelationRevision {
  id String @id @default(cuid())
  relationId String
  relation ModelRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  number Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([relationId, number])
}
model DiagramRelationUsage {
  diagramId String
  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  relationId String
  relation ModelRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  count Int
  @@id([diagramId, relationId])
  @@index([relationId])
}

model DiagramViewpoint {
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name String
  description String @default("")
  order Int @default(0)
  revision Int @default(1)
  diagrams Diagram[]
  @@unique([spaceId, name])
  @@index([spaceId, order])
}
model DiagramContextLink {
  id String @id
  relation ModelRelation @relation(fields: [id], references: [id], onDelete: Cascade)
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  entityId String
  sourceDiagramId String?
  sourceDiagram Diagram? @relation("ContextSource", fields: [sourceDiagramId], references: [id], onDelete: Cascade)
  targetDiagramId String
  targetDiagram Diagram @relation("ContextTarget", fields: [targetDiagramId], references: [id], onDelete: Cascade)
  kind String
  meaning String @default("")
  revision Int @default(1)
  @@unique([entityId, sourceDiagramId, targetDiagramId, kind])
  @@index([spaceId, entityId])
  @@index([targetDiagramId, kind])
}

model WorkspaceMember {
  spaceId String
  userId String
  role String @default("viewer")
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([spaceId, userId])
  @@index([userId])
}
model WorkspaceRole {
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name String
  actions Json
  elementIds Json @default("[]")
  revision Int @default(1)
  @@index([spaceId])
}
model WorkspaceLock {
  spaceId String
  targetId String
  rootId String
  leaseId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId String
  clientId String
  userName String
  expiresAt DateTime
  @@id([spaceId, targetId, rootId])
  @@index([expiresAt])
}
model WorkspaceEvent {
  id String @id @default(cuid())
  spaceId String
  space ModelSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId String
  userName String
  action String
  targetId String?
  createdAt DateTime @default(now())
  @@index([spaceId, createdAt])
}
