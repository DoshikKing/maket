# Public origin, without a trailing slash. Configure HTTPS at your reverse proxy.
APP_URL=https://maket.example.com
# Generate a URL-safe password: openssl rand -hex 32
POSTGRES_PASSWORD=
# Host binding for an HTTPS reverse proxy on this server.
APP_BIND=127.0.0.1
APP_PORT=3000
# Optional: password recovery only. Registration uses the invitation code from app logs.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
