# Only the subpath, not a domain: /maket, or empty for domain root. Rebuild after changing.
APP_URL=/maket
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=maket
POSTGRES_PASSWORD=
POSTGRES_DB=maket
POSTGRES_SCHEMA=public
APP_BIND=127.0.0.1
APP_PORT=3000
# Optional password recovery only. Registration uses the invitation code from app logs.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Canonical origin for recovery emails only (e.g. https://example.com).
PUBLIC_ORIGIN=
