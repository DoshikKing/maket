POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=maket
POSTGRES_PASSWORD=maket_local
POSTGRES_DB=maket
POSTGRES_SCHEMA=public
# Only the root subpath: /maket, or empty for the domain root. Restart dev after changing.
APP_URL=
# Optional password recovery. Registration uses the invitation code from app logs.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Canonical origin for recovery emails only (e.g. https://example.com). Not needed for signup/login.
PUBLIC_ORIGIN=
